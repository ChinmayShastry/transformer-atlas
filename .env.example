# Copy to .env.local for local development. Never commit the real file —
# .gitignore already excludes .env*, and this repo is public.
#
# For production, set this in Vercel: Project → Settings → Environment
# Variables. Do not rely on a local file being uploaded; it isn't.
#
# When set, visitors get a small free allowance of live API calls on your
# account before being asked to bring their own key. Set a hard spend limit
# on the OpenAI account itself — that is the only real backstop.
OPENAI_API_KEY=sk-your-key-here
